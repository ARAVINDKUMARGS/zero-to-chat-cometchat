# Copy this file to ".env" and fill in the values from the CometChat dashboard
# (app.cometchat.com -> your app -> API & Auth Keys).
# NEVER commit ".env" and NEVER put these values in the client/ folder.

COMETCHAT_APP_ID=your_app_id
COMETCHAT_REGION=us            # us | eu | in  (must match your app)
COMETCHAT_REST_API_KEY=your_REST_API_key   # the "REST API Key", NOT the "Auth Key"
PORT=3001
